<launch>
    <arg name="use_sim_time" default="false"/>
    <node pkg="alaz_lidar_clustering" exec="alaz_lidar_2d" name="alaz_lidar_node" output="screen">
        <param name="max_range" value="6.0"/>
        <param name="scan_topic" value="/sensing/scan"/>
        <param name="cluster_tolerance" value="0.8"/>
        <param name="min_cluster_size" value="3"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>
</launch>
