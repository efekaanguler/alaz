<launch>
    <arg name="use_sim_time" default="false"/>
    <arg name="publish_tf" default="false"/>
    <arg name="publish_rate_hz" default="30.0"/>
    <node pkg="odometry" exec="odom_launch" name="my_odometry_node" output="screen">
        <param from="$(find-pkg-share rdw_vehicle_description)/config/vehicle_info.param.yaml"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param name="publish_tf" value="$(var publish_tf)"/>
        <param name="publish_rate_hz" value="$(var publish_rate_hz)"/>
    </node>
</launch>
