<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="base_path" default="/workspace/modules/detection"/>
  <arg name="image_topic" default="/sensing/camera/camera0/image_raw"/>

  <node pkg="autoware_tensorrt_yolox" exec="yolox_node" name="tensorrt_yolo_main" output="screen">
    <param name="model_path" value="$(var base_path)/models/yolov8n.onnx"/> 
    <param name="label_path" value="$(var base_path)/models/coco_labels.txt"/>
    <param name="input_width" value="640"/>
    <param name="input_height" value="640"/>
    <param name="score_threshold" value="0.30"/>
    <remap from="~/input/image" to="$(var image_topic)"/>
    <remap from="~/output/objects" to="/yolox/rois0"/>
  </node>

  <node pkg="topic_tools" exec="throttle" name="traffic_light_throttle" args="messages $(var image_topic) 1.0 /sensing/camera/traffic_light_throttled">
  </node>

  <node pkg="autoware_tensorrt_yolox" exec="yolox_node" name="traffic_light_roi_detector" output="screen">
    <param name="model_path" value="$(var base_path)/models/yolox_s.onnx"/>
    <param name="input_width" value="640"/>
    <param name="input_height" value="640"/>
    <remap from="~/input/image" to="/sensing/camera/traffic_light_throttled"/>
    <remap from="~/output/objects" to="/traffic_light/rois0"/>
  </node>

  <node pkg="autoware_bytetrack" exec="bytetrack_node" name="bytetrack0" output="screen">
    <remap from="input/detection_rect" to="/yolox/rois0"/>
    <remap from="output/tracked_rect" to="/perception/object_recognition/tracking/objects"/>
    <param name="min_hits" value="1"/>
  </node>

  <node pkg="autoware_traffic_light_classifier" exec="traffic_light_classifier_node" name="traffic_light_classifier" output="screen">
    <param name="model_path" value="$(var base_path)/models/traffic_light_classifier/ped_traffic_light_classifier_mobilenetv2_batch_6.onnx"/>
    <remap from="~/input/image" to="$(var image_topic)"/>
    <remap from="~/input/rois" to="/traffic_light/rois0"/>
    <remap from="~/output/traffic_signals" to="/perception/traffic_light_recognition/traffic_signals"/>
  </node>
</launch>
