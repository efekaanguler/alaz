<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="base_path" default="/workspace/modules/detection"/>
  <arg name="image_topic" default="$(command 'python3 $(var base_path)/../global_bringup/scripts/get_topic.py camera.image_raw')"/>
  <arg name="camera_info_topic" default="$(command 'python3 $(var base_path)/../global_bringup/scripts/get_topic.py camera.camera_info')"/>
  <arg name="scan_topic" default="$(command 'python3 $(var base_path)/../global_bringup/scripts/get_topic.py lidar.scan')"/>

  <!-- ==================== YOLOX: Kamera Nesne Tespiti ==================== -->
  <node pkg="autoware_tensorrt_yolox" exec="yolox_node" name="tensorrt_yolo_main" output="screen">
    <param name="model_path" value="$(var base_path)/models/yolov8n.onnx"/>
    <param name="label_path" value="$(var base_path)/models/coco_labels.txt"/>
    <param name="input_width" value="640"/>
    <param name="input_height" value="640"/>
    <param name="score_threshold" value="0.30"/>
    <remap from="~/input/image" to="$(var image_topic)"/>
    <remap from="~/output/objects" to="/perception/object_recognition/detection/rois0"/>
  </node>

  <!-- ==================== LIDAR CLUSTERING ==================== -->
  <node pkg="alaz_lidar_clustering" exec="alaz_lidar_2d" name="alaz_lidar_node" output="screen">
    <param name="max_range" value="6.0"/>
    <param name="scan_topic" value="$(var scan_topic)"/>
    <param name="cluster_tolerance" value="0.8"/>
    <param name="min_cluster_size" value="3"/>
  </node>

  <!-- ==================== ROI CLUSTER FUSION: Lidar + Kamera Füzyonu ==================== -->
  <node pkg="autoware_image_projection_based_fusion" exec="roi_cluster_fusion_node" name="roi_cluster_fusion" output="screen">
    <param from="/opt/autoware/share/autoware_image_projection_based_fusion/config/fusion_common.param.yaml"/>
    <param from="/opt/autoware/share/autoware_launch/config/perception/object_recognition/detection/image_projection_based_fusion/roi_cluster_fusion.param.yaml"/>
    <param name="rois_number" value="1"/>
    <param name="rois_timestamp_offsets" value="[0.0]"/>
    <param name="msg3d_timeout_sec" value="0.5"/>
    <param name="rois_timeout_sec" value="0.5"/>
    <param name="point_project_to_unrectified_image" value="[false]"/>
    <param name="approximate_camera_projection" value="[false]"/>
    <param name="approximation_grid_cell_width" value="1.0"/>
    <param name="approximation_grid_cell_height" value="1.0"/>
    <remap from="~/input/rois0" to="/perception/object_recognition/detection/rois0"/>
    <remap from="~/input/camera_info0" to="$(var camera_info_topic)"/>
    <remap from="~/input/clusters" to="/perception/object_recognition/detection/clusters"/>
    <remap from="~/output/objects" to="/perception/object_recognition/detection/objects"/>
  </node>

  <!-- ==================== MULTI OBJECT TRACKER ==================== -->
  <node pkg="autoware_multi_object_tracker" exec="multi_object_tracker_node" name="multi_object_tracker" output="screen">
    <param from="/opt/autoware/share/autoware_multi_object_tracker/config/multi_object_tracker_node.param.yaml"/>
    <param from="/opt/autoware/share/autoware_multi_object_tracker/config/data_association_matrix.param.yaml"/>
    <param from="/workspace/modules/detection/config/input_channels.param.yaml"/>
    <param name="enable_delay_compensation" value="false"/>
    <param name="publish_merged_objects" value="false"/>
    <param name="world_frame_id" value="base_link"/>
    <param name="ego_frame_id" value="base_link"/>
    <remap from="input/objects" to="/perception/object_recognition/detection/objects"/>
    <remap from="output/objects" to="/perception/object_recognition/tracking/objects"/>
  </node>

  <!-- ==================== MAP BASED PREDICTION ==================== -->
  <node pkg="autoware_map_based_prediction" exec="map_based_prediction" name="map_based_prediction" output="screen">
    <param from="/opt/autoware/share/autoware_map_based_prediction/config/map_based_prediction.param.yaml"/>
    <remap from="~/input/objects" to="/perception/object_recognition/tracking/objects"/>
    <remap from="~/output/objects" to="/perception/object_recognition/objects"/>
  </node>

  <!-- ==================== TRAFFIC LIGHT THROTTLE ==================== -->
  <node pkg="topic_tools" exec="throttle" name="traffic_light_throttle"
    args="messages $(var image_topic) 1.0 /sensing/camera/traffic_light_throttled">
  </node>

</launch>

