<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="base_path" default="/workspace/modules/detection"/>
  <arg name="input_camera_topic" default="/carla/ego_vehicle/front_camera/image"/>

  <node pkg="autoware_tensorrt_yolox" exec="yolox_node" name="tensorrt_yolox0" output="screen">
    <remap from="~/input/image" to="$(var input_camera_topic)"/>
    <remap from="~/output/objects" to="/yolox/rois0"/>
    <param name="model_path" value="$(var base_path)/models/yolox_s.onnx"/>
    <param name="label_path" value="$(var base_path)/models/labels.txt"/>
    <param name="input_height" value="640"/>
    <param name="input_width" value="640"/>
    <param name="score_threshold" value="0.35"/>
  </node>

  <node pkg="autoware_bytetrack" exec="bytetrack_node" name="bytetrack0" output="screen">
    <remap from="~/input/objects" to="/yolox/rois0"/>
    <remap from="~/output/objects" to="/perception/object_recognition/tracking/objects"/>
  </node>

  <node pkg="autoware_tensorrt_yolox" exec="yolox_node" name="traffic_light_roi_detector" output="screen">
    <remap from="~/input/image" to="$(var input_camera_topic)"/>
    <remap from="~/output/objects" to="/traffic_light/rois0"/>
    <param name="model_path" value="$(var base_path)/models/yolox_s.onnx"/>
    <param name="input_height" value="640"/>
    <param name="input_width" value="640"/>
    <param name="score_threshold" value="0.25"/>
  </node>
</launch>
