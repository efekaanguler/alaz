<?xml version="1.0"?>
<package format="3">
  <name>autoware_traffic_light_classifier</name>
  <version>0.1.0</version>
  <description>Minimal traffic light classifier package compatible with Autoware-style launch arguments.</description>
  <maintainer email="zuhalkoksal@example.com">zuhalkoksal</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
