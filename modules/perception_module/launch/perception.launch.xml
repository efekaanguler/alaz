<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Perception Module Main Launch -->
  <!-- 2D LiDAR LaserScan -> Occupancy Grid for obstacle avoidance -->

  <arg name="use_sim_time" default="false"/>
  <arg name="input_scan_topic" default="/scan"/>

  <!-- Pipeline seçimi: direct | pointcloud -->
  <arg name="occ_pipeline" default="direct"/>

  <!-- PCL pipeline için ek argümanlar -->
  <arg name="output_pointcloud_topic" default="/points_raw"/>
  <arg name="target_frame" default="base_link"/>

  <!-- ================================================================ -->
  <!-- Opsiyon A: Direkt LaserScan -> OccGrid (dönüşüm yok, önerilen) -->
  <!-- ================================================================ -->
  <group if="$(eval &quot;'$(var occ_pipeline)'=='direct'&quot;)">
    <node pkg="autoware_probabilistic_occupancy_grid_map"
          exec="laserscan_based_occupancy_grid_map_node"
          name="occupancy_grid_map_node"
          output="screen">
      <!-- Remappings -->
      <remap from="~/input/laserscan" to="$(var input_scan_topic)"/>
      <remap from="~/input/obstacle_pointcloud" to="empty/obstacle_pointcloud"/>
      <remap from="~/input/raw_pointcloud" to="empty/raw_pointcloud"/>
      <remap from="~/output/occupancy_grid_map" to="/perception/occupancy_grid_map/map"/>
      <!-- Config dosyalari -->
      <param from="$(find-pkg-share autoware_probabilistic_occupancy_grid_map)/config/laserscan_based_occupancy_grid_map.param.yaml"/>
      <param from="$(find-pkg-share autoware_probabilistic_occupancy_grid_map)/config/binary_bayes_filter_updater.param.yaml"/>
      <!-- Ek parametreler -->
      <param name="input_obstacle_pointcloud" value="false"/>
      <param name="input_obstacle_and_raw_pointcloud" value="false"/>
      <param name="updater_type" value="binary_bayes_filter"/>
    </node>
  </group>

  <!-- ================================================================ -->
  <!-- Opsiyon B: LaserScan -> PCL -> OccGrid (pointcloud_based)       -->
  <!-- ================================================================ -->
  <group if="$(eval &quot;'$(var occ_pipeline)'=='pointcloud'&quot;)">
    <include file="$(find-pkg-share perception_module)/launch/laserscan_to_pcl_and_occ.launch.xml">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="input_scan_topic" value="$(var input_scan_topic)"/>
      <arg name="output_pointcloud_topic" value="$(var output_pointcloud_topic)"/>
      <arg name="target_frame" value="$(var target_frame)"/>
    </include>
  </group>
</launch>
