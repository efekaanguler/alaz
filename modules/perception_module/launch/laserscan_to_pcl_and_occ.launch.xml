<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- LaserScan -> PointCloud2 -> Occupancy Grid (Autoware) -->

  <arg name="use_sim_time" default="false"/>
  <arg name="input_scan_topic" default="/scan"/>
  <arg name="output_pointcloud_topic" default="/points_raw"/>
  <arg name="target_frame" default="base_link"/>
  <arg name="occupancy_grid_topic" default="/perception/occupancy_grid_map/map"/>

  <!-- Step 1: LaserScan -> PointCloud2 -->
  <node pkg="pointcloud_to_laserscan" exec="laserscan_to_pointcloud_node" name="laserscan_to_pointcloud" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="target_frame" value="$(var target_frame)"/>
    <remap from="scan_in" to="$(var input_scan_topic)"/>
    <remap from="cloud" to="$(var output_pointcloud_topic)"/>
  </node>

  <!-- Step 2: PointCloud2 -> Occupancy Grid (directly from autoware package) -->
  <include file="$(find-pkg-share autoware_probabilistic_occupancy_grid_map)/launch/pointcloud_based_occupancy_grid_map.launch.py">
    <arg name="input/obstacle_pointcloud" value="$(var output_pointcloud_topic)"/>
    <arg name="input/raw_pointcloud" value="$(var output_pointcloud_topic)"/>
    <arg name="output" value="$(var occupancy_grid_topic)"/>
    <arg name="use_intra_process" value="true"/>
    <arg name="use_multithread" value="true"/>
  </include>
</launch>
