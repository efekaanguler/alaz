<?xml version="1.0" encoding="UTF-8"?>
<!--
  perception.launch.xml — Main launch file for the perception pipeline.

  Launches:
  - Camera image publisher (webcam → /camera/image_raw)
  - Detection visualizer (optional)

  Usage:
    ros2 launch perception perception.launch.xml
    ros2 launch perception perception.launch.xml enable_viz:=false
-->
<launch>
  <arg name="use_sim_time" default="false"/>
  <!-- Arguments -->
  <arg name="enable_viz" default="true" description="Enable detection visualizer"/>
  <arg name="enable_ai_pipeline" default="true" description="Automatically start the NUC AI pipeline (YOLO+Fusion)"/>
  <arg name="camera_device" default="0" description="Camera device index"/>
  <arg name="image_topic" default="$(command 'python3 $(find-pkg-share global_bringup)/scripts/get_topic.py camera.image_raw')" description="Camera topic"/>
  <arg name="detection_topic" default="/perception/detections" description="Detection output topic"/>

  <!-- Webcam → ROS bridge (rdw_sensor_kit_launch içinde zaten başlatıldığı için kapatıldı) -->
  <!--
  <node pkg="perception" exec="mjpeg_to_ros.py" name="webcam_publisher" output="screen"
    unless="$(var use_sim_time)">
    <param name="device" value="$(var camera_device)"/>
    <param name="topic" value="$(var image_topic)"/>
    <param name="width" value="640"/>
    <param name="height" value="480"/>
    <param name="fps" value="30.0"/>
  </node>
  -->

  <!-- CameraInfo Fallback Publisher (YabLoc için gerekli) -->
  <node pkg="perception" exec="camera_info_fallback_publisher.py" name="camera_info_publisher" output="screen"
    args="--image-topic $(var image_topic) --camera-info-topic $(command 'python3 $(find-pkg-share global_bringup)/scripts/get_topic.py camera.camera_info') --width 640 --height 480"
    unless="$(var use_sim_time)"/>

  <!-- NUC AI Pipeline (YOLO + Lidar Fusion) -->
  <group if="$(var enable_ai_pipeline)">
    <executable cmd="bash $(find-pkg-share perception)/../../lib/perception/nuc_docker_perception.sh" output="screen" />
  </group>

  <!-- Detection visualizer (optional) -->
  <group if="$(var enable_viz)">
    <node pkg="perception" exec="visualize_detections.py" name="detection_visualizer" output="screen">
      <param name="image_topic" value="$(var image_topic)"/>
      <param name="detection_topic" value="$(var detection_topic)"/>
    </node>
  </group>
</launch>
