<?xml version="1.0"?>
<launch>
  <!-- Backward-compatible wrapper: prefer yolov8.launch.xml for new integrations. -->
  <arg name="yolox_node_name" default="tensorrt_yolox0"/>
  <arg name="image_transport_decompressor_node_name" default="image_transport_decompressor_node0"/>
  <arg name="input/image" default="/sensing/camera/camera0/image_raw"/>
  <arg name="output/objects" default="rois0"/>
  <arg name="model_path"/>
  <arg name="label_path" default=""/>
  <arg name="color_map_path" default=""/>
  <arg name="input_width" default="640"/>
  <arg name="input_height" default="640"/>
  <arg name="score_threshold" default="0.35"/>
  <arg name="nms_threshold" default="0.45"/>
  <arg name="device" default="cpu"/>
  <arg name="class_allowlist" default="0,2"/>

  <include file="$(find-pkg-share autoware_tensorrt_yolox)/launch/yolov8.launch.xml">
    <arg name="yolov8_node_name" value="$(var yolox_node_name)"/>
    <arg name="image_transport_decompressor_node_name" value="$(var image_transport_decompressor_node_name)"/>
    <arg name="input/image" value="$(var input/image)"/>
    <arg name="output/objects" value="$(var output/objects)"/>
    <arg name="model_path" value="$(var model_path)"/>
    <arg name="label_path" value="$(var label_path)"/>
    <arg name="color_map_path" value="$(var color_map_path)"/>
    <arg name="input_width" value="$(var input_width)"/>
    <arg name="input_height" value="$(var input_height)"/>
    <arg name="score_threshold" value="$(var score_threshold)"/>
    <arg name="nms_threshold" value="$(var nms_threshold)"/>
    <arg name="device" value="$(var device)"/>
    <arg name="class_allowlist" value="$(var class_allowlist)"/>
  </include>
</launch>
