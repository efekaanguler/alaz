<?xml version="1.0"?>
<launch>
  <arg name="input/objects" default="rois0"/>
  <arg name="input/traffic_signals_2d" default="classified/traffic_signals"/>

  <arg name="output/detected_objects" default="/perception/object_recognition/detection/objects"/>
  <arg name="output/tracked_objects" default="/perception/object_recognition/tracking/objects"/>
  <arg name="output/predicted_objects" default="/perception/object_recognition/objects"/>
  <arg name="output/traffic_signals" default="/perception/traffic_light_recognition/traffic_signals"/>

  <!-- A 2D pixel box has no metric pose or map traffic-light ID. Keep all
       Autoware-native outputs off unless a calibrated projection supplies them. -->
  <arg name="publish_detected_objects" default="false"/>
  <arg name="publish_tracked_objects" default="false"/>
  <arg name="publish_predicted_objects" default="false"/>
  <arg name="publish_traffic_signals" default="false"/>

  <node pkg="autoware_detection_autoware_bridge" exec="detection_autoware_bridge_node" name="detection_autoware_bridge" output="screen">
    <param name="publish_detected_objects" value="$(var publish_detected_objects)"/>
    <param name="publish_tracked_objects" value="$(var publish_tracked_objects)"/>
    <param name="publish_predicted_objects" value="$(var publish_predicted_objects)"/>
    <param name="publish_traffic_signals" value="$(var publish_traffic_signals)"/>

    <remap from="~/input/tracked_detections" to="$(var input/objects)"/>
    <remap from="~/input/traffic_signals_2d" to="$(var input/traffic_signals_2d)"/>

    <remap from="~/output/detected_objects" to="$(var output/detected_objects)"/>
    <remap from="~/output/tracked_objects" to="$(var output/tracked_objects)"/>
    <remap from="~/output/predicted_objects" to="$(var output/predicted_objects)"/>
    <remap from="~/output/traffic_signals" to="$(var output/traffic_signals)"/>
  </node>
</launch>
