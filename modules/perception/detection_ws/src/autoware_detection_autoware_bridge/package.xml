<?xml version="1.0"?>
<package format="3">
  <name>autoware_detection_autoware_bridge</name>
  <version>0.1.0</version>
  <description>Bridge Detection2DArray outputs to Autoware perception topics and message types.</description>
  <maintainer email="zuhalkoksal@example.com">zuhalkoksal</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>autoware_perception_msgs</exec_depend>
  <exec_depend>unique_identifier_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
