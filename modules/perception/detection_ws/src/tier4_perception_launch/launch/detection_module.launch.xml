  <arg name="enable_traffic_light_classifier" default="true"/>
  <arg name="use_yolov8_for_traffic_light_roi" default="true"/>
  <arg name="traffic_light_input_image" default="$(var image_raw0)"/>
  <arg name="traffic_light_roi_topic" default="traffic_light/rois0"/>
  <arg name="traffic_light_output_topic" default="classified/traffic_signals"/>

  <arg name="traffic_light_detector/model_path" default="$(var camera_2d_detector/model_path)"/>
  <arg name="traffic_light_detector/label_path" default="$(var camera_2d_detector/label_path)"/>
