  <arg name="use_bytetrack" default="true"/>
  <arg name="enable_visualizer" default="false"/>
  <arg name="camera_index" default="0"/>
  <arg name="detector_ns" default=""/>
  <let name="detector_ns" value="yolov8/" if="$(var use_bytetrack)"/>

  <arg name="camera_2d_detector/model_path" default="/workspace/modules/detection/models/yolov8n.onnx"/>
  <arg name="camera_2d_detector/label_path" default="/workspace/modules/detection/models/labels.txt"/>
