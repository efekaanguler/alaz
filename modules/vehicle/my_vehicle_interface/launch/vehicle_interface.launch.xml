<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Vehicle Interface Launch File for SDC 2026 Kart -->
  
  <!-- Arguments -->
  <arg name="vehicle_id" default="$(env VEHICLE_ID alaz)"/>
  <arg name="config_file" default="$(find-pkg-share my_vehicle_interface)/config/vehicle_interface.param.yaml"/>
  <arg name="can_interface" default="can0"/>
  <arg name="launch_can_bridge" default="true"/>

  <include file="$(find-pkg-share ros2_socketcan)/launch/socket_can_bridge.launch.xml"
           if="$(var launch_can_bridge)">
    <arg name="interface" value="$(var can_interface)"/>
    <arg name="from_can_bus_topic" value="/from_can_bus"/>
    <arg name="to_can_bus_topic" value="/to_can_bus"/>
    <arg name="enable_can_fd" value="false"/>
    <arg name="enable_frame_loopback" value="false"/>
  </include>

  <!-- Vehicle Interface Node -->
  <node pkg="my_vehicle_interface" exec="my_vehicle_interface_node" name="vehicle_interface_node" output="screen">
    <param from="$(var config_file)"/>
  </node>
</launch>
