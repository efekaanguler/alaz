<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="software_test_mode" default="false"/>
  
  <arg name="vehicle_info_param_file" default="$(find-pkg-share rdw_vehicle_description)/config/vehicle_info.param.yaml"/>

  <group scoped="false">
    <include file="$(find-pkg-share autoware_global_parameter_loader)/launch/global_params.launch.py">
      <arg name="vehicle_info_param_file" value="$(var vehicle_info_param_file)"/>
    </include>
  </group>

  <include file="$(find-pkg-share rdw_vehicle_launch)/launch/vehicle_interface.launch.xml">
    <arg name="vehicle_id" value="$(var vehicle_id)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="software_test_mode" value="$(var software_test_mode)"/>
  </include>
</launch>
