<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="vehicle_id" default="$(env VEHICLE_ID alaz)"/>
  <arg name="vehicle_model" default="my_vehicle"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="can_interface" default="can0"/>
  <arg name="launch_can_bridge" default="true"/>

  <group scoped="false">
    <include file="$(find-pkg-share autoware_global_parameter_loader)/launch/global_params.launch.py">
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>
  </group>

  <include file="$(find-pkg-share my_vehicle_launch)/launch/vehicle_interface.launch.xml">
    <arg name="vehicle_id" value="$(var vehicle_id)"/>
    <arg name="can_interface" value="$(var can_interface)"/>
    <arg name="launch_can_bridge" value="$(var launch_can_bridge)"/>
  </include>
</launch>
