<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rdw_sensor_kit_launch</name>
  <version>0.1.0</version>
  <description>The rdw_sensor_kit_launch package for 3 Cameras and 1 2D LiDAR</description>
  <maintainer email="kekecmehmet71@gmail.com">Mehmet Kekeç</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <!-- ÖNEMLİ: Az önce oluşturduğumuz description paketini buraya eklemeliyiz -->
  <exec_depend>rdw_sensor_kit_description</exec_depend>
  <exec_depend>common_sensor_launch</exec_depend>
  <exec_depend>topic_tools</exec_depend>

  <!-- KAMERA SÜRÜCÜSÜ -->
  <!-- Eğer kameralarınız standart USB webcam ise bu kalabilir. 
       Farklı bir marka (Basler, FLIR vb.) ise onun driver paketini ekleyin. -->
  <exec_depend>usb_cam</exec_depend>

  <!-- 2D LIDAR DESTEĞİ -->
  <!-- 2D Lidarınızın markasına ait driver (Örnek: urg_node, rplidar_ros, sick_scan) -->
  <!-- Buraya kendi lidar paketinizin adını yazın, örnek olarak urg_node bırakıldı -->
  <exec_depend>urg_node</exec_depend> 
  
  <!-- Autoware 3D Pointcloud beklediği için 2D veriyi dönüştüren paket gerekebilir -->
  <!-- Genellikle pointcloud_to_laserscan paketi tersini de yapar veya laserscan_to_pointcloud node'u kullanılır -->
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>autoware_vehicle_velocity_converter</exec_depend>

  <!-- Autoware Temel Bileşenleri -->
  <!-- 2D Lidar kullanırken pointcloud_preprocessor yapılandırması farklı olacaktır 
       ama bağımlılık olarak kalmasında sakınca yoktur. -->
  <exec_depend>autoware_pointcloud_preprocessor</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>autoware_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
