<?xml version="1.0"?>
<launch>
  <arg name="serial_port" default="/dev/ttyUSB0"/>
  <arg name="serial_baudrate" default="115200"/>
  <arg name="scan_mode" default="Standard"/>

  <node pkg="rplidar_ros" exec="rplidar_node" name="lidar_driver" namespace="/sensing/lidar/top" output="screen">
    <param name="channel_type" value="serial"/>
    <param name="serial_port" value="$(var serial_port)"/>
    <param name="serial_baudrate" value="$(var serial_baudrate)"/>
    <param name="frame_id" value="lidar_link"/>
    <param name="inverted" value="false"/>
    <param name="angle_compensate" value="true"/>
    <param name="scan_mode" value="$(var scan_mode)"/>
  </node>

  <node pkg="pointcloud_to_laserscan" exec="laserscan_to_pointcloud_node" name="laserscan_to_pointcloud" namespace="/sensing/lidar/top" output="screen">
    <remap from="scan_in" to="/sensing/lidar/top/scan"/>
    <remap from="cloud" to="/sensing/lidar/top/pointcloud_raw"/>
  </node>
</launch>