<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="lidar_device" default="/dev/sllidar" description="SLLiDAR device path"/>
  <arg name="frame_id" default="lidar_link" description="Frame id for LiDAR"/>
  <arg name="use_sim_time" default="false"/>

  <node pkg="sllidar_ros2" exec="sllidar_node" name="sllidar_node" output="screen">
    <param name="serial_port" value="$(var lidar_device)"/>
    <param name="serial_baudrate" value="115200"/>
    <param name="frame_id" value="$(var frame_id)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
