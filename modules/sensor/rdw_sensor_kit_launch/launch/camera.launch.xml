<?xml version="1.0"?>
<launch>
  <node pkg="usb_cam" exec="usb_cam_node_exe" name="camera_center" namespace="/sensing" output="screen">
    <param name="video_device" value="/dev/video0"/>
    <param name="camera_name" value="logitech_720p"/>
    <param name="pixel_format" value="mjpeg2rgb"/>
    <param name="image_width" value="1280"/>
    <param name="image_height" value="720"/>
    <param name="framerate" value="30.0"/>
    <param name="camera_info_url" value="file://$(find-pkg-share rdw_sensor_kit_launch)/config/logitech_720p_camera_info.yaml"/>
    <remap from="image_raw" to="/sensing/camera/camera_center/image_raw"/>
    <remap from="camera_info" to="/sensing/camera/camera_center/camera_info"/>
  </node>
</launch>