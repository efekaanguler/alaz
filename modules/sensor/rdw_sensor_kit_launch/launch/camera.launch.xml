<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="camera_device" default="/dev/center_camera" description="Center camera device path or index"/>
  <arg name="image_topic" default="/sensing/image_raw" description="Camera topic"/>

  <!-- v4l2_camera yerine perception paketindeki mjpeg_to_ros.py kullanılıyor -->
  <node pkg="perception" exec="mjpeg_to_ros.py" name="center_camera" output="screen">
    <param name="device" value="$(var camera_device)"/>
    <param name="topic" value="$(var image_topic)"/>
    <param name="width" value="1280"/>
    <param name="height" value="720"/>
    <param name="fps" value="30.0"/>
  </node>
</launch>
