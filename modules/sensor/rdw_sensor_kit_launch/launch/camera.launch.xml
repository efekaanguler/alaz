<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="camera_device" default="/dev/center_camera" description="Center camera device"/>

  <node pkg="v4l2_camera" exec="v4l2_camera_node" name="center_camera" output="screen">
    <param name="video_device" value="$(var camera_device)"/>
    <param name="pixel_format" value="YUYV"/>
    <param name="image_size" value="[1280,720]"/>
    <param name="output_encoding" value="bgr8"/>
  </node>
</launch>
