<?xml version="1.0"?>
<package format="3">
  <name>localization</name>
  <version>1.0.0</version>
  <description>
    Localization bringup/config package (YabLoc-first). Holds launch + configs; can be extended with EKF/VSLAM later.
  </description>

  <maintainer email="kekecmehmet71@gmail.com">Alaz Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Launch runtime deps -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <!-- Optional (often already available). Keep commented if you want it minimal. -->
  <!-- <exec_depend>python3-yaml</exec_depend> -->

  <export>
    <build_type>ament_cmake</build_type>
    <launch>
      <launch_file>launch/localization.launch.py</launch_file>
    </launch>
  </export>
</package>
