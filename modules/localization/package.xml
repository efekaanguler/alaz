<?xml version="1.0"?>
<package format="3">
  <name>localization</name>
  <version>0.0.1</version>
  <description>
    Localization bringup/config package (YabLoc-first). Holds launch + configs; can be extended with EKF/VSLAM later.
  </description>

  <maintainer email="you@example.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Launch runtime deps -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>autoware_map_msgs</exec_depend>
  <exec_depend>geographic_msgs</exec_depend>
  <exec_depend>topic_tools</exec_depend>
  <exec_depend>autoware_map_loader</exec_depend>
  <exec_depend>yabloc_common</exec_depend>
  <exec_depend>yabloc_image_processing</exec_depend>
  <exec_depend>yabloc_particle_filter</exec_depend>

  <!-- Optional (often already available). Keep commented if you want it minimal. -->
  <!-- <exec_depend>python3-yaml</exec_depend> -->

  <export>
    <build_type>ament_cmake</build_type>
    <launch>
      <launch_file>launch/localization.launch.py</launch_file>
    </launch>
  </export>
</package>
